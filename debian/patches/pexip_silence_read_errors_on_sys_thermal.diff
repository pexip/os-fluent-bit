                               const char *join_a, const char *join_b,
+                              bool log_error,
                               uint64_t *out_val)
 {
     int fd;
@@ -124,7 +125,11 @@ int ne_utils_file_read_uint64(struct flb
     fd = open(p, O_RDONLY);
     if (fd == -1) {
         if (ctx) {
-            flb_plg_error(ctx->ins, "could not open '%s'", p);
+            if (log_error) {
