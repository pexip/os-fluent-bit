+            } else {
+                flb_plg_debug(ctx->ins, "could not open '%s'", p);
+            }
         }
         else {
             flb_errno();
@@ -136,7 +141,11 @@ int ne_utils_file_read_uint64(struct flb
     bytes = read(fd, &tmp, sizeof(tmp));
     if (bytes == -1) {
         if (ctx) {
-            flb_plg_error(ctx->ins, "could not read from '%s'", p);
+            if (log_error) {
+                flb_plg_error(ctx->ins, "could not read from '%s'", p);
+            } else {
+                flb_plg_debug(ctx->ins, "could not read from '%s'", p);
+            }
         }
         else {
             flb_errno();
@@ -157,6 +166,24 @@ int ne_utils_file_read_uint64(struct flb
     return 0;
 }
 
+int ne_utils_file_read_uint64(struct flb_ne *ctx,
+                              const char *mount,
+                              const char *path,
+                              const char *join_a, const char *join_b,
